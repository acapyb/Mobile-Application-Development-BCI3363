<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#FAF5FF">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select your Faculty:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <!-- RadioGroup -->
    <RadioGroup
        android:id="@+id/radioGroupFaculty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioFK"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Faculty of Computing" />

        <RadioButton
            android:id="@+id/radioFIM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Faculty of Industrial Management" />

        <RadioButton
            android:id="@+id/radioOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Other" />


        <!-- Exercise: Additional Radio Buttons -->

        <RadioButton
            android:id="@+id/radioPreferNot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prefer not to say" />

        <RadioButton
            android:id="@+id/radioConfidential"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confidential" />


    </RadioGroup>

    <!-- Submit Button -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit"
        android:layout_marginTop="20dp"
        android:backgroundTint="#7E57C2"
        android:textColor="@android:color/white" />

    <!-- Result -->
    <TextView
        android:id="@+id/txtResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        android:textColor="#000000"/>

</LinearLayout>

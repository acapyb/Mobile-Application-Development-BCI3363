<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0D192C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERSONAL INFORMATION"
            android:textAlignment="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#90CAF9"
            android:layout_marginBottom="25dp"/>

        <!-- Profile Picture -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/asyraf_pfp"
            android:contentDescription="Profile Picture"
            android:scaleType="centerCrop"
            android:layout_marginBottom="15dp"/>

        <!-- Student Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Muhamad Asyraf bin Yang Budiman"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- Student Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Computer Systems and Networking Student"
            android:textSize="14sp"
            android:textColor="#A8BED9"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>

        <!-- Personal Information Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_intro_card"
            android:padding="20dp"
            android:layout_marginBottom="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student Details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="20dp"/>

            <!-- Matric Number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matric Number"
                android:textSize="14sp"
                android:textColor="#90CAF9"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CA24045"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="18dp"/>

            <!-- University -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="University"
                android:textSize="14sp"
                android:textColor="#90CAF9"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Universiti Malaysia Pahang Al-Sultan Abdullah"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="18dp"/>

            <!-- Programme -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Programme"
                android:textSize="14sp"
                android:textColor="#90CAF9"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Computer Systems and Networking"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="18dp"/>

            <!-- Campus -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campus"
                android:textSize="14sp"
                android:textColor="#90CAF9"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pekan, Pahang"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="18dp"/>

            <!-- Hobbies -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hobbies"
                android:textSize="14sp"
                android:textColor="#90CAF9"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gaming and Coding"
                android:textSize="17sp"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Back to Home"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>
